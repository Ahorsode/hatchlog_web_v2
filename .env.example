# Canonical production site (required for Google OAuth redirects on Vercel)
NEXT_PUBLIC_SITE_URL="https://hatchlog-one.vercel.app"

# Supabase Auth (required on Vercel)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# HatchLog NestJS API (sole backend for farm data)
HATCHLOG_API_URL="http://localhost:3001"
HATCHLOG_INTERNAL_API_KEY="change-me-to-a-long-random-secret"
HATCHLOG_ADMIN_API_KEY="change-me-admin-api-key"

# Admin panel HMAC session (not farm JWT)
HATCHLOG_ADMIN_SESSION_SECRET="your-admin-secret-min-32-chars"
HATCHLOG_ADMIN_USERNAME="admin"
HATCHLOG_ADMIN_PASSWORD_HASH="bcrypt-hash-of-admin-password"
# Must match a row in Nest DB admin_user.id (FK for license mutations)
HATCHLOG_ADMIN_ID="your-admin-user-cuid"
# Also required on Nest for token generation
HATCHLOG_LICENSE_TOKEN_SECRET="your-license-token-secret-min-16"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Sentry (optional)
SENTRY_DSN="https://your-private-sentry-dsn@sentry.io/project"
NEXT_PUBLIC_SENTRY_DSN="https://your-public-sentry-dsn@sentry.io/project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token-for-source-map-uploads"

# NOTE: DATABASE_URL / DIRECT_URL / Prisma are NOT required on Vercel.
# Postgres is accessed only by Nest on Railway.
